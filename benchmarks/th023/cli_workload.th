fn main() -> Tensor<f32,1> {
    let x = [13.5,12.25,11.0,9.75,8.5,7.25,6.0,4.75,3.5,2.25,1.0,0.5,0.25,0.75,1.5,2.25,3.0,3.75,4.5,5.25,6.0,6.75,7.5,8.25,9.0,9.75,10.5,11.25,12.0,12.75,13.5,14.25]
    let y = [2.5,3.25,4.125,5.5,6.75,7.875,8.25,9.5,10.625,11.75,12.875,13.0,14.25,15.375,16.5,17.625,18.75,19.875,20.0,21.25,22.375,23.5,24.625,25.75,26.875,27.0,28.25,29.375,30.5,31.625,32.75,33.875]
    let a = x + y
    let c = a .* y
    let d = c - x
    let e = d + y
    return e
}
