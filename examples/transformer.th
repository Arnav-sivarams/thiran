X = Input(2, 4)
Wq = Input(4, 4)
Wk = Input(4, 4)
Wv = Input(4, 8)
Q = MatMul(X, Wq)
K = MatMul(X, Wk)
KT = Transpose(K)
Scores = MatMul(Q, KT)
Attention = Softmax(Scores)
V = MatMul(X, Wv)
Context = MatMul(Attention, V)
Wo = Input(8, 4)
Projected = MatMul(Context, Wo)
Residual = Add(Projected, X)
O = Output(Residual)
