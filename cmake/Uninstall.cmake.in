cmake_policy(SET CMP0054 NEW)
set(manifest "@CMAKE_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR "No install manifest exists")
endif()
file(STRINGS "${manifest}" installed)
if(NOT installed)
    message(FATAL_ERROR "Install manifest is empty")
endif()
set(prefix "")
foreach(path IN LISTS installed)
    cmake_path(NORMAL_PATH path)
    get_filename_component(name "${path}" NAME)
    get_filename_component(bin "${path}" DIRECTORY)
    get_filename_component(bin_name "${bin}" NAME)
    get_filename_component(candidate "${bin}" DIRECTORY)
    if(NOT "${name}" STREQUAL "thiran" OR NOT "${bin_name}" STREQUAL "bin" OR "${candidate}" STREQUAL "/")
        message(FATAL_ERROR "Unsafe install manifest path: ${path}")
    endif()
    if(NOT "${prefix}" STREQUAL "" AND NOT "${candidate}" STREQUAL "${prefix}")
        message(FATAL_ERROR "Install manifest contains multiple prefixes")
    endif()
    set(prefix "${candidate}")
endforeach()
foreach(path IN LISTS installed)
    file(REMOVE "${path}")
endforeach()
file(GLOB remaining "${prefix}/bin/*")
if(NOT remaining)
    file(REMOVE_RECURSE "${prefix}/bin")
endif()
